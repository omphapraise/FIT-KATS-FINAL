{
  "name": "fitkats-backend",
  "version": "1.0.0",
  "description": "Fit Kats Gym App API (Node.js + Express + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node --check src/server.js && node --check src/db.js",
    "seed": "node src/seed.js",
    "seed:reset": "node src/seed.js --reset",
    "validate:knowledge": "node scripts/validate-knowledge.js",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
